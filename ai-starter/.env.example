# Không đưa secret vào mã nguồn hoặc frontend.
AITC_API_KEY=
AITC_BASE_URL=https://api.thucchien.ai

# Model mặc định; có thể override theo từng request.
AI_TEXT_MODEL=gpt-6-luna
AI_IMAGE_MODEL=nano-banana-2-lite
AI_VIDEO_MODEL=veo-3.1-lite-generate-001
AI_TTS_MODEL=gemini-2.5-flash-preview-tts
AI_STT_MODEL=gemini-3.5-transcribe-preview
AI_EMBEDDING_MODEL=text-multilingual-embedding-002

# Bảo vệ budget và độ ổn định.
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_MAX_VIDEO_SECONDS=8
AI_DRY_RUN=false
AI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
